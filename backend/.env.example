DATABASE_URL=postgresql://scheduleassist:scheduleassist@localhost:5432/scheduleassist

# Google OAuth client (GCP Console > APIs & Services > Credentials).
# The redirect URI below must be registered on the client exactly.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

FRONTEND_URL=http://localhost:5173

# Any long random string; signs the temporary OAuth-handshake cookie.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
