DATABASE_URL=postgresql://scheduleassist:scheduleassist@localhost:5432/scheduleassist

# Where this API and the browser app are served from. Every absolute URL the
# app builds — both OAuth callbacks and the post-sign-in redirect — is derived
# from these, so deploying means changing them here and nowhere else.
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Google OAuth client (GCP Console > APIs & Services > Credentials).
# Sign-in and calendar access are separate consents — signing in never asks for
# calendar permission — so BOTH of these paths must be registered as redirect
# URIs on the client, using the BACKEND_URL above:
#   <BACKEND_URL>/api/auth/google/callback
#   <BACKEND_URL>/api/calendars/google/callback
# Connecting a calendar also requires the Google Calendar API to be enabled
# on the project.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Any long random string; signs the temporary OAuth-handshake cookie.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Encrypts calendar OAuth tokens at rest. Keep this out of the database and out
# of version control: rotating or losing it makes every stored calendar token
# unreadable, and users have to reconnect their calendars.
# Generate one with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CALENDAR_TOKEN_KEY=change-me
